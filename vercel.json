{
  "version": 2,
  "framework": null,
  "buildCommand": "cd frontend/car-main && npm ci && npm run build",
  "outputDirectory": "frontend/car-main/dist",
  "installCommand": "echo 'root install skipped'",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/auth/(.*)", "destination": "/api/index" },
    { "source": "/admin/(.*)", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" },
    { "source": "/_health", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x"
    }
  }
}
