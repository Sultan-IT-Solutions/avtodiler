generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model CarMake {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameRu    String
  nameKz    String
  nameEn    String
  models    CarModel[]
  cars      Car[]
  createdAt DateTime @default(now())
}

model CarModel {
  id        Int     @id @default(autoincrement())
  makeId    Int
  slug      String
  nameRu    String
  nameKz    String
  nameEn    String
  make      CarMake @relation(fields: [makeId], references: [id])
  cars      Car[]

  @@unique([makeId, slug])
}

model Car {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  makeId        Int
  modelId       Int
  year          Int
  engine        String?
  mileageKm     Int?
  priceKzt      Int?
  isNew         Boolean  @default(false)
  imagesJson    String?
  videoUrl      String?
  hoverMediaUrl String?
  titleRu       String
  titleKz       String
  titleEn       String
  descRu        String?
  descKz        String?
  descEn        String?
  createdAt     DateTime @default(now())

  make  CarMake  @relation(fields: [makeId], references: [id])
  model CarModel @relation(fields: [modelId], references: [id])
  leads Lead[]
}

model Brand {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  titleRu      String
  titleKz      String
  titleEn      String
  descRu       String?
  descKz       String?
  descEn       String?
  historyRu    String?
  historyKz    String?
  historyEn    String?
  philosophyRu String?
  philosophyKz String?
  philosophyEn String?
  mediaJson    String?
  createdAt    DateTime @default(now())
}

model ServiceItem {
  id        Int      @id @default(autoincrement())
  titleRu   String
  titleKz   String
  titleEn   String
  descRu    String?
  descKz    String?
  descEn    String?
  priceKzt  Int?
  createdAt DateTime @default(now())
  leads     Lead[]
}

model Offer {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  titleRu   String
  titleKz   String
  titleEn   String
  descRu    String?
  descKz    String?
  descEn    String?
  imageUrl  String?
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime @default(now())
}

model DealerCenter {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameRu    String
  nameKz    String
  nameEn    String
  addressRu String
  addressKz String
  addressEn String
  phone     String
  hoursRu   String?
  hoursKz   String?
  hoursEn   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  leads     Lead[]
}

model Lead {
  id          Int      @id @default(autoincrement())
  type        String
  name        String
  phone       String
  comment     String?
  lang        String   @default("ru")
  carId       Int?
  serviceId   Int?
  dealerId    Int?
  createdAt   DateTime @default(now())

  car     Car?         @relation(fields: [carId], references: [id])
  service ServiceItem? @relation(fields: [serviceId], references: [id])
  dealer  DealerCenter? @relation(fields: [dealerId], references: [id])
}

model SeoPage {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  titleRu       String?
  titleKz       String?
  titleEn       String?
  descriptionRu String?
  descriptionKz String?
  descriptionEn String?
  h1Ru          String?
  h1Kz          String?
  h1En          String?
  createdAt     DateTime @default(now())
}
